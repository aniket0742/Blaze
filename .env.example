# Supabase Postgres connection string (Session pooler, port 5432).
# Copy this file to .env.local and fill in the real value.
# .env.local is gitignored — never commit the real string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth. Project Settings -> API in the Supabase dashboard.
# The anon key is a public, browser-safe key — it is not a secret, but it
# still belongs in .env.local rather than in committed code.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Open Food Facts and Open Prices, used only by `npm run db:seed` to import the
# catalog. Both ask every client to identify itself as App/Version (email).
# Server-side only — deliberately not NEXT_PUBLIC_, so it never reaches a browser.
OFF_USER_AGENT="Blaze/1.0 (you@example.com)"
