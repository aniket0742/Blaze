# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build

# env files — never commit secrets. .env.example is the one exception and
# must stay below the ignore rules, or the negation does not apply.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent capture internals (the logs themselves in .agent-logs/ ARE committed)
.claude/.capture-state/

# misc
.DS_Store
*.pem
npm-debug.log*
